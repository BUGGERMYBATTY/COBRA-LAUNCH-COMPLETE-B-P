# Backend API Configuration
# IMPORTANT: For Vercel deployments, DO NOT set this variable (leave it unset/empty)
# Only set this for local development if running backend separately: http://localhost:3001
# VITE_BACKEND_API_URL=

# Backend Port (used by backend server only)
BACKEND_PORT=3001

# Pinata Configuration for IPFS Storage (BACKEND ONLY - Not exposed to frontend)
# Get your JWT from https://app.pinata.cloud/developers/api-keys
VITE_PINATA_JWT=your_pinata_jwt_token_here

# Pinata Dedicated Gateway
# Format: https://your-gateway.mypinata.cloud
VITE_PINATA_GATEWAY=https://yellow-peculiar-cephalopod-560.mypinata.cloud

# Solana Network Configuration
# Options: devnet, testnet, mainnet-beta
VITE_SOLANA_NETWORK=mainnet-beta

# Optional: Custom RPC Endpoint
# Leave empty to use default Solana RPC
# VITE_SOLANA_RPC_ENDPOINT=https://your-custom-rpc-endpoint.com
