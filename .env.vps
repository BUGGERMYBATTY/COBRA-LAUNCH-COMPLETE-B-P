# ============================================
# COBRA LAUNCH - VPS DEPLOYMENT ENVIRONMENT VARIABLES
# ============================================
# Rename this file to .env before deploying
# ============================================

# --------------------------------------------
# BACKEND CONFIGURATION
# --------------------------------------------
# Port for the backend server
BACKEND_PORT=3001

# Backend API URL - Set this to your domain or server IP
# Examples:
# - Development: http://localhost:3001
# - Production with domain: https://yourdomain.com
# - Production with IP: http://your-server-ip:3001
VITE_BACKEND_API_URL=http://localhost:3001

# --------------------------------------------
# PINATA CONFIGURATION (REQUIRED)
# --------------------------------------------
# Get your JWT from: https://app.pinata.cloud/developers/api-keys
# Click "New Key" → Enable "pinFileToIPFS" → Copy JWT
VITE_PINATA_JWT=your_pinata_jwt_token_here

# Your Pinata dedicated gateway URL
# Find this in: Pinata Dashboard → Gateways
# Format: https://your-gateway-name.mypinata.cloud
VITE_PINATA_GATEWAY=https://yellow-peculiar-cephalopod-560.mypinata.cloud

# --------------------------------------------
# SOLANA NETWORK CONFIGURATION
# --------------------------------------------
# Network options: devnet, testnet, mainnet-beta
# Use devnet for testing, mainnet-beta for production
VITE_SOLANA_NETWORK=mainnet-beta

# --------------------------------------------
# SOLANA RPC ENDPOINT (OPTIONAL)
# --------------------------------------------
# Leave empty to use default Solana RPC (free but rate-limited)
# For production, use a paid RPC provider for better performance:
# - Helius: https://helius.dev
# - QuickNode: https://quicknode.com
# - Alchemy: https://alchemy.com
# Example: https://mainnet.helius-rpc.com/?api-key=your-api-key
VITE_SOLANA_RPC_ENDPOINT=

# --------------------------------------------
# TREASURY WALLET ADDRESS (REQUIRED)
# --------------------------------------------
# Your Solana wallet address to receive token creation fees
# The 0.1 SOL fee will be sent here
# Example: 7xKXtg2CW87d97TXJSDpbD5jBkheTqA83TZRuJosgAsU
VITE_TREASURY_ADDRESS=your_solana_wallet_address_here

# ============================================
# DEPLOYMENT CHECKLIST
# ============================================
# 1. Fill in all values above
# 2. Rename this file to .env
# 3. Update VITE_BACKEND_API_URL to your production URL
# 4. Update nginx.conf with your domain name
# 5. Deploy using Docker or PM2 (see VPS_DEPLOYMENT_GUIDE.md)
# ============================================
